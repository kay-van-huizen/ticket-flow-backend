# Lokale configuratie voor docker compose.
# Kopieer dit bestand naar .env (staat in .gitignore) en vul je eigen waarden in.

# Wachtwoord voor de Postgres-gebruiker "ticketflow".
# Kies een eigen sterk wachtwoord. Wordt alleen gebruikt bij de eerste start met een leeg volume.
POSTGRES_PASSWORD=change-me

KC_ADMIN_PASSWORD=change-me

KEYCLOAK_ISSUER=http://localhost:8180/realms/ticketflow
KEYCLOAK_JWKS=http://localhost:8180/realms/ticketflow/protocol/openid-connect/certs